# Токен от @BotFather
BOT_TOKEN=123456789:AA...

# Постоянные админы: Telegram ID через запятую (узнать свой ID: @userinfobot).
# Остальных админов любой админ назначает в боте: Админка → Администраторы.
ADMIN_IDS=123456789

# База данных.
#   Разработка (по умолчанию): sqlite+aiosqlite:///data/bot.db
#   Продакшн:                  postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# Необязательно: Redis для состояний диалогов (переживают перезапуск бота)
# REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO

# Только для docker-compose: пароль PostgreSQL-контейнера
# POSTGRES_PASSWORD=придумайте-длинный-пароль
